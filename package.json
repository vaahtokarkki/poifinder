{
  "name": "wayside",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo root: the Wayside web app and the self hosted Overpass API it can talk to",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @wayside/frontend",
    "build": "npm run build -w @wayside/frontend",
    "prerender": "npm run prerender -w @wayside/frontend",
    "seo:data": "npm run seo:data -w @wayside/frontend",
    "lint": "npm run lint -w @wayside/frontend",
    "compile": "npm run compile -w @wayside/frontend",
    "deploy": "npm run deploy -w @wayside/frontend",
    "overpass:filters": "npm run overpass:filters -w @wayside/frontend",
    "basemap:import": "npm run basemap:import -w @wayside/frontend",
    "basemap:sprite": "npm run basemap:sprite -w @wayside/frontend",
    "overpass:up": "docker compose -f apps/overpass/docker-compose.yml up -d --build",
    "overpass:logs": "docker compose -f apps/overpass/docker-compose.yml logs -f",
    "overpass:update": "docker compose -f apps/overpass/docker-compose.yml exec overpass update-poi-db"
  }
}
