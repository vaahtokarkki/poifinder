#!/bin/bash
#
# Cut an OpenStreetMap extract down to the objects the app can ask for.
#
#   filter-osm-extract [FILE]        default /db/planet.osm.bz2
#
# FILE is replaced, in place, by a bzip2 XML file holding only the objects
# carrying one of the tags in osmium-filter.txt, plus the nodes those objects
# are built from, which Overpass needs to place a way or a relation on the map.
#
# The name is what the caller already expects: the container entrypoint hands
# us /db/planet.osm.bz2 (whatever OVERPASS_PLANET_URL actually pointed at) and
# then feeds the same path to bunzip2, so a real .osm.bz2 has to come back.
#
# Used twice: by OVERPASS_PLANET_PREPROCESS on the first import, and by
# update-poi-db on every refresh. Both must filter identically, which is the
# reason this is one script rather than a line of shell in the compose file.

set -euo pipefail

FILTER_FILE=${WAYSIDE_FILTER_FILE:-/opt/wayside/osmium-filter.txt}
TARGET=${1:-/db/planet.osm.bz2}
RAW="${TARGET}.raw"

if [[ ! -s $TARGET ]]; then
	echo "filter-osm-extract: $TARGET is missing or empty" >&2
	exit 1
fi
if [[ ! -s $FILTER_FILE ]]; then
	echo "filter-osm-extract: $FILTER_FILE is missing or empty" >&2
	exit 1
fi

mv -f "$TARGET" "$RAW"

# osmium takes the format from the file name, and we have just taken the file
# name away from it. Read the magic bytes instead: the extract is normally a
# .pbf, but a .osm.bz2 URL has to work too
case "$(od -An -tx1 -N4 "$RAW" | tr -d ' \n')" in
425a68*) FORMAT=osm.bz2 ;; # "BZh"
1f8b*) FORMAT=osm.gz ;;
3c*) FORMAT=osm ;; # "<", uncompressed XML
*) FORMAT=pbf ;;
esac

BEFORE=$(stat -c %s "$RAW")
echo "filter-osm-extract: filtering $(numfmt --to=iec "$BEFORE") of $FORMAT with $FILTER_FILE"

osmium tags-filter \
	--verbose \
	--overwrite \
	--input-format="$FORMAT" \
	--output-format=osm.bz2 \
	--expressions="$FILTER_FILE" \
	--output="$TARGET" \
	"$RAW"

AFTER=$(stat -c %s "$TARGET")
echo "filter-osm-extract: $(numfmt --to=iec "$BEFORE") -> $(numfmt --to=iec "$AFTER") (bzip2 XML)"

rm -f "$RAW"
