{
	# No ACME, no certificates, no redirect to https. The Tailscale funnel
	# terminates TLS on the public name and forwards cleartext here, so
	# everything Caddy would otherwise do about HTTPS is either duplicated
	# work or a challenge it cannot pass — the name does not resolve to
	# this machine.
	#
	# auto_https off rather than relying on the bare `:80` below to imply
	# it: the site address and the TLS behaviour are two settings, and one
	# of them being changed later should not quietly switch ACME back on
	auto_https off

	# Nothing needs the admin API, and it listens on 2019 by default
	admin off

	# Believe the forwarding headers the tunnel sets. Every connection here
	# arrives from loopback or the Docker bridge — cloudflared on the host,
	# or the Tailscale funnel, through the published port — and since Caddy
	# 2.6 an X-Forwarded-For from a peer it does not trust is replaced, not
	# appended to. Without this, Overpass saw every visitor as the Docker
	# gateway: the access log had no client addresses, and the per-address
	# rate limit was one bucket shared by everybody
	servers {
		trusted_proxies static private_ranges
	}
}

# Any host, on the container's port 80. No hostname to match, because the
# funnel is the only thing that can reach this and it is the funnel that
# knows the public name — writing it here as well would be a second place
# to update the day it changes
:80 {
	# Overpass. handle rather than handle_path: the interpreter really is
	# at /api/interpreter on the upstream, so the prefix stays on
	handle /api/* {
		# No CORS header here on purpose. The Overpass container sets its own
		# from OVERPASS_CORS_ORIGIN, and a second Access-Control-Allow-Origin
		# on the same response is not "more permissive" — a browser rejects
		# the pair outright, and the map falls back to the public mirrors
		# with nothing in the log to say why
		reverse_proxy overpass:80 {
			# These queries are slow by design: OVERPASS_TIME above allows 480
			# seconds of server time, and the default proxy timeout would cut a
			# long one off at the socket while the server was still working
			transport http {
				response_header_timeout 120s
				read_timeout 120s
			}
		}
	}

	# The noise tiles, straight off the disk. `current` is the symlink the
	# builder swaps, so a rebuild is visible without restarting anything
	handle_path /tiles/* {
		root * /srv/tiles/current

		# `defer` matters, and so does every line in here.
		#
		# Without defer these are applied before file_server runs, and
		# file_server then overwrites Content-Type with the octet-stream it
		# sniffed — Caddy has no mime type for .pbf — and MapLibre will not
		# parse a tile that arrives as octet-stream.
		#
		# Content-Encoding is declared rather than produced. tippecanoe
		# writes the tiles gzipped and they are served as they lie, which is
		# both smaller on disk and free at request time. Caddy's own `encode`
		# was tried here and measured at no compression at all on this
		# content — 49,758 bytes out of 49,733 in, against 38,744 for
		# gzip -9 — because it emits stored blocks on a streamed file
		header {
			defer
			Content-Type "application/x-protobuf"
			Content-Encoding "gzip"

			# The app is served from wayside.cc and this is another origin, so
			# the tiles need this to be readable at all. Unlike the Overpass
			# block above, nothing upstream sets it — these are files
			Access-Control-Allow-Origin "*"

			# Ten minutes fresh, then a day of serving the old tile while a
			# new one is fetched behind it.
			#
			# The tile URLs carry no hash — /tiles/12/2200/1343.pbf is the same
			# path whatever built it — so a cache entry is the only thing
			# standing between a rebuild and a reader, and at the day this
			# used to be a reader who had opened the map that morning saw the
			# old model until the evening.
			#
			# stale-while-revalidate is what makes ten minutes affordable: the
			# reader still gets an instant tile from cache, the browser
			# refetches it in the background, and the next pan has the new
			# one. A map asks for dozens of tiles a screen, so revalidating
			# each of them in the foreground — max-age=0, or no-cache — would
			# put a round trip in front of every one of them
			Cache-Control "public, max-age=600, stale-while-revalidate=86400"

			-Server
		}

		file_server
	}

	# The air quality tiles, and the station snapshot beside them. Same
	# arrangement as /tiles above — files off the disk, under the symlink
	# the builder swaps — with one difference that matters.
	#
	# Two kinds of file share this root. The tiles are protobuf and
	# stations.json is JSON, and getting either Content-Type wrong is a
	# silent failure: MapLibre will not parse a tile that arrives as
	# octet-stream, and fetch() will not parse JSON that arrives as
	# protobuf.
	#
	# Note the block form on the two matched headers. `header @pbf defer
	# Content-Type "..."` is valid Caddyfile and does something else
	# entirely — it parses `defer` as the field name and sets a header
	# called "defer" — so the tiles go out with whatever file_server
	# sniffed, which for .pbf is nothing at all. That cost an afternoon
	# once; it is written the long way here so it cannot happen again.
	handle_path /air/* {
		root * /srv/air/current

		header {
			defer

			# The app is served from wayside.cc and this is another origin
			Access-Control-Allow-Origin "*"

			# Shorter than the noise tiles', because this is rebuilt every
			# hour rather than by hand: five minutes fresh, then an hour of
			# serving the old tile while a new one is fetched behind it. A
			# reader who leaves the map open sees the new hour on their
			# next pan rather than the next morning
			Cache-Control "public, max-age=300, stale-while-revalidate=3600"

			-Server
		}

		# Declared rather than produced, and only for the two files the
		# builder actually writes gzipped. wayside.json and tippecanoe's own
		# metadata.json share this root and are plain JSON — declaring gzip
		# on those too was a real bug, not a harmless overstatement: a client
		# that trusts the header enough to decode by it (curl among them)
		# fails outright on a body that was never compressed
		@gzipped path *.pbf /stations.json
		header @gzipped Content-Encoding "gzip"

		@pbf path *.pbf
		header @pbf {
			defer
			Content-Type "application/x-protobuf"
		}

		@json path *.json
		header @json {
			defer
			Content-Type "application/json; charset=utf-8"
		}

		file_server
	}

	# Nothing else is served from this name. A bare 404 rather than a
	# redirect to the site: this host is an API endpoint, and anything
	# asking it for a page is not a reader who took a wrong turn
	handle {
		respond 404
	}

	# A tile with nothing in it is not an error. MapLibre treats 404 as an
	# empty tile but logs it first; 204 says the same thing without filling
	# a visitor's console with our infrastructure. `close` matters too — a
	# 204 must carry no body, or the Content-Encoding set above would be
	# describing a gzip stream that is not there.
	#
	# At the site level rather than inside the /tiles block, because
	# handle_errors is not an ordered handler and Caddy refuses it nested
	# in a handle_path. It needs no path matcher even so: the `respond 404`
	# above produces a *response* rather than an error, so the only thing
	# that ever reaches here with a 404 is file_server missing a tile
	handle_errors {
		@missing expression {err.status_code} == 404

		# Content-Encoding survives from the header block above even though
		# nothing reaches file_server to produce a body — Caddy carries
		# response headers into error handling rather than resetting them.
		# Left in, a 204 with no body ends up declaring a gzip stream that
		# is not there, and a client that decodes by the header (a browser
		# among them) sees a hard fetch error instead of the empty tile
		# this was written to produce
		header @missing -Content-Encoding
		respond @missing 204 {
			close
		}
	}

	log {
		output stdout
		format console
	}
}
