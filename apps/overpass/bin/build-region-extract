#!/bin/bash
#
# Build one filtered OSM extract out of a list of smaller regional ones.
#
#   build-region-extract [FILE]      default /db/planet.osm.bz2
#
#   --list=FILE       region list to read, default $WAYSIDE_REGION_LIST
#   --refresh=WHICH   which regions to fetch again: all, or a comma separated
#                     list of names in which "oldest" and "random" stand in for
#                     one, and "oldest:N" and "random:N" for N of them.
#                     Default all
#   --parts-dir=DIR   where the per region files are kept between runs
#   --fresh           re-download everything, ignoring a half finished run
#   --keep-parts      no-op, kept for callers that still pass it
#
# The per region files are kept between runs, which is what makes a partial
# refresh possible: --refresh=finland fetches Finland and reuses the other
# forty eight as they are. Several may be named at once, which costs one
# download each and no extra import. Anything missing is always fetched,
# whatever --refresh says, so a region can never quietly go absent from the map.
#
# What that does not avoid is the rest of the work. Overpass cannot update part
# of a database, so every run still merges all the parts, compresses them and
# imports the lot. A nightly one country refresh is a smaller download and the
# same import, seven times a week.
#
# FILE is replaced by a bzip2 XML file holding the filtered contents of every
# region in the list, which is the same thing filter-osm-extract produces from
# a continent file and is what init_osm3s.sh will bunzip2 into the importer.
#
# Why not just filter the continent file. osmium tags-filter has to know which
# nodes the ways it keeps are built from, and it tracks that in a bitmap sized
# by the largest node id in the input rather than by how many nodes it ends up
# keeping. Against europe-latest.osm.pbf that is a fixed cost of well over a
# gigabyte no setting brings down, on top of a 35 GB download that has to sit
# on the disk in one piece while osmium reads it twice. A small server gets OOM
# killed, and it gets OOM killed hours in, having downloaded all 35 GB first.
#
# Fifty country files cost the same bytes over the wire and rather more wall
# clock, and in exchange nothing here ever holds more than the largest single
# country. They also make the job interruptible: a region already filtered is
# not filtered again, so a run that dies picks up where it stopped rather than
# starting the download over.
#
# A region that cannot be downloaded no longer takes the run with it. It is
# retried, resuming where the transfer stopped, and if it still will not come
# the run goes on to the next region and says at the end which ones it left
# behind. Where there is a part from a previous run the map keeps it, a country
# out of date rather than a country missing; where there is none the region is
# left out of this build and fetched again by the next run, because a missing
# part is always fetched whatever --refresh says. Eighty-six regions imported
# tonight beats none, which is what one reset connection at region 85 used to
# cost.
#
# The regions must not overlap, or their shared objects are imported twice.
# See the header of europe-regions.txt or world-regions.txt.
#
# A list line is a URL, optionally followed by the name the region goes by in
# --refresh and in the parts directory. Without one the name is the basename,
# which is unique for countries and not below them: europe/georgia and
# us/georgia are both "georgia", and two regions with one name is an error.

set -euo pipefail

REGION_LIST=${WAYSIDE_REGION_LIST:-/opt/wayside/europe-regions.txt}
TARGET=/db/planet.osm.bz2
FRESH=false
PARTS_DIR=${WAYSIDE_PARTS_DIR:-}

# Which regions to fetch again. "all" is the whole continent in one go and what
# a weekly rebuild wants; a comma separated list of names, "random" or "oldest"
# (optionally ":N" for several) refreshes those and leaves the rest of the
# parts alone
REFRESH=${WAYSIDE_REFRESH:-all}

# How old a part may be and still be reused, under --refresh=all only. Long
# enough that a run resuming after a crash keeps this morning's work, short
# enough that a rebuild cannot quietly ship a region from the week before.
# A named, random or oldest refresh ignores this: there the age of the other
# parts is the point rather than a problem
REUSE_HOURS=${WAYSIDE_REGION_REUSE_HOURS:-24}

# Seconds to wait between regions, and how long to wait before trying a region
# again when its download failed or what came back was not an extract. Fifty
# files in a row off a free download server is worth being unhurried about; a
# few seconds each is nothing against an import measured in hours
REGION_PAUSE=${WAYSIDE_REGION_PAUSE:-5}
RETRY_BACKOFF=${WAYSIDE_RETRY_BACKOFF:-60}
DOWNLOAD_TRIES=${WAYSIDE_DOWNLOAD_TRIES:-3}

for arg in "$@"; do
	case "$arg" in
	--list=*) REGION_LIST="${arg#--list=}" ;;
	--refresh=*) REFRESH="${arg#--refresh=}" ;;
	--parts-dir=*) PARTS_DIR="${arg#--parts-dir=}" ;;
	--fresh) FRESH=true ;;
	--keep-parts) ;; # parts are always kept now
	-h | --help)
		cat <<-'USAGE'
			Usage: build-region-extract [--list=FILE] [--refresh=WHICH] [--parts-dir=DIR] [--fresh] [FILE]

			Downloads and filters the extracts in the region list, one at a time,
			and merges the results into FILE (default /db/planet.osm.bz2) as the
			bzip2 XML the Overpass importer reads.

			  --list=FILE     region list to read, default $WAYSIDE_REGION_LIST
			  --refresh=WHICH which regions to fetch again, default all:
			                    all       every region, the whole list
			                    random    one picked at random
			                    random:N  N of them, picked at random
			                    oldest    the one refreshed longest ago
			                    oldest:N  the N refreshed longest ago
			                    a,b,c     these regions by name
			                  The list may mix them: finland,sweden,oldest:2
			                  refreshes both countries and the two that have
			                  waited longest, in one import rather than four.
			                  Regions with no part yet are always fetched.
			  --parts-dir=DIR where per region files are kept between runs
			  --fresh         re-download everything, ignoring a half finished run
		USAGE
		exit 0
		;;
	-*)
		echo "build-region-extract: unknown option $arg" >&2
		exit 1
		;;
	*) TARGET="$arg" ;;
	esac
done

if [[ ! -s $REGION_LIST ]]; then
	echo "build-region-extract: $REGION_LIST is missing or empty" >&2
	exit 1
fi

# Where the parts live between runs. Beside the target by default, which keeps
# a one off invocation self contained; update-poi-db points this at /db/regions
# instead, outside the working directory it wipes, because a part kept is a
# country that does not have to be downloaded again tonight
WORK=${PARTS_DIR:-"$(dirname "$TARGET")/regions"}
STAMP_FILE="${TARGET}.timestamp"

log() { echo "build-region-extract: $(date '+%F %T') $*"; }

# Is this an OSM extract, or is it the download server talking to us. Geofabrik
# answers a URL it does not recognise with its web page and a 200 rather than a
# 404, so curl -f is happy and osmium dies on "Unknown top-level element: html"
# however many minutes of download later, the magic bytes having said that a
# file starting with < is XML. Better to say so before the filter runs
looks_like_osm() {
	case "$(od -An -tx1 -N4 "$1" | tr -d ' \n')" in
	425a68* | 1f8b*) return 0 ;;                           # bzip2, gzip
	0000*) return 0 ;;                                     # pbf, a big endian blob length
	3c*) head -c 4096 "$1" | grep -q '<osm' && return 0 ;; # XML, but whose
	esac
	return 1
}

# One region's extract onto the disk, or a non-zero return when this run could
# not get it. Everything transient is retried here rather than being fatal.
#
# curl's own --retry covers the timeouts and the 5xx range and very little
# else. The connection reset that kills a 400 MB download two thirds of the way
# through is CURLE_RECV_ERROR, which it will not retry at all without
# --retry-all-errors: without that flag the caller saw one curl error, on one
# region out of eighty-seven, and abandoned the whole night's rebuild.
#
# Between attempts the partial file is kept and the transfer resumed, which on
# a region this size is the difference between losing a minute and losing
# twenty. Only while that is getting somewhere, though: an attempt that adds no
# bytes is as likely to be a server that will not serve ranges as a second bad
# connection, and the way out of that one is to start the file again.
download_region() {
	local label=$1 name=$2 url=$3 raw=$4
	local attempt=0 backoff before after
	local resume=()

	while true; do
		attempt=$((attempt + 1))
		before=$(stat -c %s "$raw" 2>/dev/null || echo 0)

		if [[ ${#resume[@]} -gt 0 ]]; then
			log "$label $name: downloading, attempt $attempt of $DOWNLOAD_TRIES, resuming at $(numfmt --to=iec "$before")"
		elif [[ $attempt -eq 1 ]]; then
			log "$label $name: downloading"
		else
			log "$label $name: downloading, attempt $attempt of $DOWNLOAD_TRIES"
		fi

		# --no-progress-meter rather than -s: fifty progress bars is not what
		# the container log is for, but a curl error still is
		if curl -fL --no-progress-meter \
			--retry 2 --retry-delay 15 --retry-all-errors --retry-connrefused \
			"${resume[@]}" -o "$raw" "$url"; then

			# A URL Geofabrik does not recognise is answered with its web page
			# and a 200 rather than a 404, so curl being happy is not the end
			# of the question. Better to say so here than to have osmium die on
			# "Unknown top-level element: html" a filter pass later
			looks_like_osm "$raw" && return 0

			log "$label $name: what came back is not an OSM extract. It began: $(head -c 120 "$raw" | tr -d '\0' | tr '\n' ' ')"
			rm -f "$raw"
		else
			log "$label $name: the download failed"
		fi

		if [[ $attempt -ge $DOWNLOAD_TRIES ]]; then
			rm -f "$raw"
			return 1
		fi

		# Resume next time only where this attempt actually added something.
		# No new bytes means resuming would ask the same question again and get
		# the same answer, so the file goes and the next attempt starts clean
		after=$(stat -c %s "$raw" 2>/dev/null || echo 0)
		resume=()
		if [[ $after -gt $before ]]; then
			resume=(--continue-at -)
		else
			rm -f "$raw"
		fi

		# Could be a bad URL, could be the server having a moment. One is worth
		# waiting out and the other is not, and they look alike from here
		backoff=$((RETRY_BACKOFF * attempt))
		log "$label $name: retrying in ${backoff}s"
		sleep "$backoff"
	done
}

# Comments and blank lines out, so the list can explain itself. Trimming is per
# line and deliberately not `tr -d [:space:]`, which eats the newlines too and
# hands the loop all fifty URLs concatenated into one
mapfile -t ENTRIES < <(sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$REGION_LIST" | grep -v '^$')
if [[ ${#ENTRIES[@]} -eq 0 ]]; then
	echo "build-region-extract: no regions in $REGION_LIST" >&2
	exit 1
fi

# The URL half of a region list line, which may carry a name after it
entry_url() {
	local url
	read -r url _ <<<"$1"
	printf '%s' "$url"
}

# The name a region is known by, here and in --refresh. The basename by
# default, or the second field of the line when it has one. Below country level
# the basename is not unique — europe/georgia and us/georgia are both "georgia"
# — and two regions sharing a name is an error rather than something to
# resolve, so those lines name themselves
region_name() {
	local url name
	read -r url name <<<"$1"
	if [[ -n ${name:-} ]]; then
		printf '%s' "$name"
		return
	fi
	name=$(basename "$url")
	name=${name%%.*}
	printf '%s' "${name%-latest}"
}

ALL_NAMES=()
for e in "${ENTRIES[@]}"; do ALL_NAMES+=("$(region_name "$e")"); done

mkdir -p "$WORK"

# The parts by age, least recently refreshed first, so the rotation is even and
# the worst case staleness is the number of regions divided by how many a run
# takes, rather than whatever the dice say. One "name<tab>mtime" line each, and
# nothing at all when no part exists yet.
#
# Sorted rather than a single minimum because a run may ask for several: the
# nightly schedule takes the two oldest beside the countries it always
# refreshes, and two runs a night would be two full imports for it
oldest_regions() {
	local name part
	for name in "${ALL_NAMES[@]}"; do
		part="${WORK}/${name}.osm.pbf"
		[[ -s $part ]] || continue
		printf '%s\t%s\n' "$(stat -c %Y "$part")" "$name"
	done | sort -n | while IFS=$'\t' read -r mtime name; do
		printf '%s\t%s\n' "$name" "$mtime"
	done
}

# Work out which regions this run fetches again. Missing parts are added later,
# per region, so this set is only about the ones already on disk.
#
# "all" is every region. Anything else is a comma separated list of names, in
# which "oldest" and "random" stand in for one region each and "oldest:N" and
# "random:N" for N of them. That is what lets one run refresh the four countries
# worth keeping current *and* the two that have waited longest, and it matters
# more than it looks: Overpass cannot update part of a database, so every run
# reimports all 87 parts whichever ones it downloaded. Six runs in a night is
# six full imports for no more data than one run asking for six regions.
REFRESH_SET=()
if [[ $REFRESH == all ]]; then
	REFRESH_SET=("${ALL_NAMES[@]}")
else
	IFS=',' read -r -a REFRESH_TOKENS <<<"$REFRESH"

	# Named regions first, picked ones second, whatever order they were written
	# in. A name is a decision already made, so "oldest" and "random" choose
	# around it rather than over it: on a night when Finland happens to be the
	# oldest part, finland,oldest:2 would otherwise ask for Finland twice and
	# refresh two regions where three were meant
	for token in "${REFRESH_TOKENS[@]}"; do
		case "${token%%:*}" in
		random | oldest) continue ;;
		esac
		if [[ " ${ALL_NAMES[*]} " != *" $token "* ]]; then
			echo "build-region-extract: no region called $token in $REGION_LIST" >&2
			echo "build-region-extract: known regions: ${ALL_NAMES[*]}" >&2
			exit 1
		fi
		if [[ " ${REFRESH_SET[*]:-} " != *" $token "* ]]; then
			REFRESH_SET+=("$token")
		fi
	done

	# Then the ones this run chooses for itself. "oldest" and "random" take an
	# optional count — oldest:2 is the two that have waited longest — because
	# Overpass reimports every part whichever ones were downloaded, so asking
	# for two regions in one run costs one extra download and no extra import,
	# where two runs would be two imports
	for token in "${REFRESH_TOKENS[@]}"; do
		KIND=${token%%:*}
		case "$KIND" in
		random | oldest) ;;
		*) continue ;;
		esac

		COUNT=1
		if [[ $token == *:* ]]; then COUNT=${token#*:}; fi
		if [[ ! $COUNT =~ ^[1-9][0-9]*$ ]]; then
			echo "build-region-extract: $token needs a count of one or more, as in ${KIND}:2" >&2
			exit 1
		fi

		if [[ $KIND == random ]]; then
			# Over 87 regions this is roughly an even rotation, but only
			# roughly: random leaves some regions waiting a good deal longer.
			# "oldest" is the same idea with a bound on the wait.
			#
			# Drawn without replacement, out of what is not already spoken for,
			# so random:3 is three different regions rather than three throws
			# that may land twice on the same one
			CANDIDATES=()
			for NAME in "${ALL_NAMES[@]}"; do
				if [[ " ${REFRESH_SET[*]:-} " != *" $NAME "* ]]; then
					CANDIDATES+=("$NAME")
				fi
			done
			while [[ $COUNT -gt 0 && ${#CANDIDATES[@]} -gt 0 ]]; do
				IDX=$((RANDOM % ${#CANDIDATES[@]}))
				PICK=${CANDIDATES[IDX]}
				CANDIDATES=("${CANDIDATES[@]:0:IDX}" "${CANDIDATES[@]:IDX+1}")
				log "picked $PICK at random out of ${#ALL_NAMES[@]}"
				REFRESH_SET+=("$PICK")
				COUNT=$((COUNT - 1))
			done
			continue
		fi

		mapfile -t CANDIDATES < <(oldest_regions)
		if [[ ${#CANDIDATES[@]} -eq 0 ]]; then
			# Nothing on disk yet, so everything is about to be fetched anyway
			log "no parts yet, so this is a first build rather than a refresh"
			continue
		fi
		PICKED=0
		for CANDIDATE in "${CANDIDATES[@]}"; do
			if [[ $PICKED -ge $COUNT ]]; then break; fi
			PICK=${CANDIDATE%%$'\t'*}
			WHEN=${CANDIDATE##*$'\t'}
			# Already named, or already picked by an earlier token. It is being
			# refreshed tonight either way, so move on to the next oldest
			# rather than spending one of the count on it
			if [[ " ${REFRESH_SET[*]:-} " == *" $PICK "* ]]; then continue; fi
			log "$PICK is among the least recently refreshed, last done $(date -d "@$WHEN" '+%F %T')"
			REFRESH_SET+=("$PICK")
			PICKED=$((PICKED + 1))
		done
		if [[ $PICKED -lt $COUNT ]]; then
			# Fewer parts on disk than the count asked for, which on a list of
			# 87 means a first build still filling in. The missing ones are
			# fetched anyway, so this is worth saying and not worth failing on
			log "wanted $COUNT oldest, found $PICKED not already being refreshed"
		fi
	done
fi

if [[ $FRESH == true ]]; then
	rm -rf "$WORK"
fi
mkdir -p "$WORK"

STARTED=$(date +%s)
log "${#ENTRIES[@]} regions from $REGION_LIST"

PARTS=()
NAMES=()

# What this run could not download: the ones falling back on a part from an
# earlier run, and the ones with no part to fall back on. Both are reported at
# the end, because a build quietly short of a country is the failure worth
# being loud about now that a failed download is no longer fatal
STALE=()
MISSING=()

NEWEST=""
INDEX=0

for ENTRY in "${ENTRIES[@]}"; do
	INDEX=$((INDEX + 1))
	URL=$(entry_url "$ENTRY")
	NAME=$(region_name "$ENTRY")
	PART="${WORK}/${NAME}.osm.pbf"
	RAW="${WORK}/${NAME}.download"

	# Two URLs whose names collide would write over each other's part and
	# leave the merge reading one of them twice, which is a region quietly
	# missing from the map rather than anything that looks like a failure
	if [[ " ${NAMES[*]} " == *" $NAME "* ]]; then
		echo "build-region-extract: two regions in $REGION_LIST are both called $NAME" >&2
		exit 1
	fi
	NAMES+=("$NAME")

	# Fetch when there is nothing to reuse, or when this run is refreshing this
	# region. Under --refresh=all the age of the part decides instead, so that a
	# rebuild interrupted halfway resumes rather than starting over
	FETCH=false
	if [[ $FRESH == true || ! -s $PART ]]; then
		FETCH=true
	elif [[ " ${REFRESH_SET[*]:-} " == *" $NAME "* ]]; then
		if [[ $REFRESH == "all" ]]; then
			find "$PART" -newermt "-${REUSE_HOURS} hours" | grep -q . || FETCH=true
		else
			FETCH=true
		fi
	fi

	if [[ $FETCH == false ]]; then
		log "[$INDEX/${#ENTRIES[@]}] $NAME: keeping $(numfmt --to=iec "$(stat -c %s "$PART")") from $(date -r "$PART" '+%F')"
	elif download_region "[$INDEX/${#ENTRIES[@]}]" "$NAME" "$URL" "$RAW"; then
		log "[$INDEX/${#ENTRIES[@]}] $NAME: filtering"
		filter-osm-extract "$RAW" "$PART"
		rm -f "$RAW"

		# Fifty downloads back to back is the kind of traffic that gets a
		# client throttled in the first place, and a few seconds each is
		# nothing against an import measured in hours
		if [[ $INDEX -lt ${#ENTRIES[@]} ]]; then
			sleep "$REGION_PAUSE"
		fi
	elif [[ -s $PART ]]; then
		# Last run's copy of the region, so the map has the country a few days
		# out of date rather than not at all. Its mtime is deliberately left
		# alone: that keeps it near the front of the oldest queue, so the next
		# --refresh=oldest run comes back to it on its own
		STALE+=("$NAME")
		log "[$INDEX/${#ENTRIES[@]}] $NAME: could not be downloaded, keeping $(numfmt --to=iec "$(stat -c %s "$PART")") from $(date -r "$PART" '+%F')"
	else
		# Nothing to fall back on, so this build has a hole where the region
		# is. The next run fetches it whatever --refresh says, because a part
		# that does not exist is always fetched
		MISSING+=("$NAME")
		log "[$INDEX/${#ENTRIES[@]}] $NAME: could not be downloaded and has no part to fall back on, leaving it out of this build"
		continue
	fi

	PARTS+=("$PART")

	# When the region was last current, from the pbf header the filter carried
	# through, which costs a read of the first few kilobytes. Reading it from
	# the part rather than the download is both cheaper and the only version
	# that works on the reuse path, where the download is long gone
	REGION_STAMP=$(osmium fileinfo -g header.option.osmosis_replication_timestamp "$PART" 2>/dev/null || true)
	if [[ -n $REGION_STAMP ]]; then
		if [[ -z ${NEWEST:-} || $REGION_STAMP > $NEWEST ]]; then NEWEST=$REGION_STAMP; fi
		if [[ -z ${OLDEST:-} || $REGION_STAMP < $OLDEST ]]; then OLDEST=$REGION_STAMP; fi
	fi
done

if [[ ${#STALE[@]} -gt 0 ]]; then
	log "${#STALE[@]} region(s) could not be downloaded and kept the part from an earlier run: ${STALE[*]}"
fi
if [[ ${#MISSING[@]} -gt 0 ]]; then
	log "${#MISSING[@]} region(s) are not in this build at all: ${MISSING[*]}"
	log "the next run fetches them whatever --refresh says. If one was renamed or withdrawn, fix $REGION_LIST"
fi

# Every region failed, which is a network or a region list rather than a bad
# night. Replacing the extract with nothing would import an empty map over a
# working one, so the old target is left where it is and the caller stops
if [[ ${#PARTS[@]} -eq 0 ]]; then
	echo "build-region-extract: not one of the ${#ENTRIES[@]} regions could be downloaded" >&2
	echo "build-region-extract: leaving $TARGET alone rather than building an empty map" >&2
	exit 1
fi

log "merging ${#PARTS[@]} regions into $TARGET"

# Every part is sorted by type and id, which is what merge needs, and it drops
# an object that turns up in two of them. Borders are where that happens: a
# Geofabrik extract carries whole ways across its edge, so a beach on the
# Dutch-Belgian line is in both files
osmium merge \
	--verbose \
	--overwrite \
	--output-format=osm.bz2 \
	--output="$TARGET" \
	"${PARTS[@]}"

# The oldest region, not the newest, is what this database is current as of.
# With regions refreshed one at a time the newest is always today, and saying
# so would claim the whole map is a day old when one country is and the rest
# are weeks behind. Overpass reports this back in every answer as
# timestamp_osm_base, so it is a claim made to everyone who queries
if [[ -n ${OLDEST:-} ]]; then
	printf '%s\n' "$OLDEST" >"$STAMP_FILE"
else
	rm -f "$STAMP_FILE"
fi

# The parts stay. They are the reason a refresh can be one country rather than
# a continent, and for Europe they come to a few hundred megabytes
log "done in $((($(date +%s) - STARTED) / 60)) min, $(numfmt --to=iec "$(stat -c %s "$TARGET")") of bzip2 XML"
if [[ -n ${OLDEST:-} ]]; then
	log "regions span $OLDEST (oldest, and what the database reports) to ${NEWEST} (newest)"
fi
log "parts kept in $WORK, $(du -sh "$WORK" 2>/dev/null | cut -f1) across ${#PARTS[@]} regions"
