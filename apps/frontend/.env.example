# Copy to .env. Vite reads it at build time, so these end up in the bundle:
# nothing here can be a secret.

# Driving routes to a marker. Without it the map still works, the route line
# is what goes missing
VITE_ORS_API_KEY=

# A self hosted Overpass instance (apps/overpass). Set it and the app queries
# only that server, once, with no failover and no backoff. Leave it empty and
# it uses the public mirrors, which need both.
#   VITE_OVERPASS_API_URL=http://localhost:12345/api/interpreter
VITE_OVERPASS_API_URL=http://localhost:12345/api/interpreter
