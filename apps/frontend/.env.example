# Copy to .env. Vite reads it at build time, so these end up in the bundle:
# nothing here can be a secret.

# Driving routes to a marker. Without it the map still works, the route line
# is what goes missing
VITE_ORS_API_KEY=

# A self hosted Overpass instance (apps/overpass). Set it and the app asks that
# server first, once, with no retries and nothing said in the loading screen.
# Only if it fails does it fall back to the public mirrors, and then the
# loading screen says so. Leave it empty and the mirrors are all there is.
#   VITE_OVERPASS_API_URL=http://localhost:12345/api/interpreter
VITE_OVERPASS_API_URL=http://localhost:12345/api/interpreter

# Matomo, self hosted next to the Overpass instance (apps/overpass). Set both
# and the app loads the tracker; leave either empty and it tracks nothing at
# all, which is what a dev build and a preview want.
#
# The tracker runs with cookies disabled and Do Not Track honoured, so the site
# shows no consent banner. That only holds while the server side holds up its
# end — see "Analytics" in apps/overpass/README.md.
#   VITE_MATOMO_URL=https://analytics.example.com/
VITE_MATOMO_URL=
VITE_MATOMO_SITE_ID=1

# The CARTO basemaps key the map itself is drawn with. Free up to CARTO's fair
# use limit, requested at https://carto.com/basemaps/apikey/. Leave it empty
# and the vector basemap still loads today, unkeyed and unmetered on CARTO's
# goodwill — they have said the key is coming for vector as it already has for
# raster, and on that day an unkeyed build has no basemap at all.
VITE_CARTO_API_KEY=

# Modelled traffic noise, built by apps/noise and served as vector tiles. Set
# it to the origin the tiles are under — no trailing slash, no {z}/{x}/{y} —
# and the map gains a layer you can switch on and a noise line in every popup.
#
# Leave it empty and none of that exists: no source in the style, no tile
# request, no control, no row. A checkout with no tile server is a working
# checkout, which is why this is a variable rather than a build flag.
#
# Development, with apps/noise's own compose file running:
#   VITE_NOISE_TILES_URL=http://localhost:8080
# Production, behind the Caddy in apps/overpass/docker-compose.prod.yml:
#   VITE_NOISE_TILES_URL=https://tiles.example.com
VITE_NOISE_TILES_URL=

# Air quality, built by apps/air from OpenAQ and served as vector tiles. Set it
# to the origin the tiles are under — no trailing slash, no {z}/{x}/{y} — and
# the map gains a second overlay you can switch on, and an air quality line in
# the popups of the places you would linger in.
#
# Leave it empty and none of that exists: no source in the style, no tile
# request, no station snapshot fetched, no tile in the layers panel, no row.
# Same rule as the noise tiles above, and the layers panel is rendered when
# either of the two is set.
#
# Note that the popup does not read these tiles. It fetches stations.json from
# the same origin and quotes the nearest actual monitor, because an
# interpolated colour is a guess and "18 µg/m³, measured 12 km away" is a fact.
#
# Development, with apps/air's own compose file running:
#   VITE_AIR_TILES_URL=http://localhost:8081
# Production, behind the Caddy in apps/overpass/docker-compose.prod.yml:
#   VITE_AIR_TILES_URL=https://tiles.example.com/air
VITE_AIR_TILES_URL=
