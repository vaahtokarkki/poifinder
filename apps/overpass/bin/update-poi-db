#!/bin/bash
#
# Rebuild the POI database from a fresh OpenStreetMap extract.
#
#   docker compose exec overpass update-poi-db
#
#   --url=URL        extract to import, default $OVERPASS_PLANET_URL
#   --regions=FILE   build the extract from a region list instead of one URL
#   --skip-download  reuse the extract left by a previous run
#   --keep-extract   do not delete the extract afterwards
#
# Overpass normally keeps itself current by applying minute diffs. This
# instance cannot: a diff carries every object in the region, and nothing in it
# says which of them our filtered import kept, so applying one would slowly
# refill the database with the objects we deliberately left out. Playgrounds
# and post boxes do not move often, so a periodic reimport is both simpler and
# honest about what it does. Run it weekly from cron.
#
# The new database is built alongside the live one and only swapped in at the
# end, so queries are answered throughout the import and the API is down for
# the second it takes to rename two directories.
#
# It runs in either of two places. Inside the serving container, where it stops
# and starts the dispatcher through supervisor. Or in a container of its own
# that shares the /db volume, where there is no supervisor to talk to and
# WAYSIDE_RESTART_CONTAINER names the container to restart instead. The second
# is what keeps a 35 GB download out of the server's startup path entirely.

set -euo pipefail

DB_DIR=/db/db
WORK_DIR=/db/update
NEW_DB="${WORK_DIR}/db"
EXTRACT="${WORK_DIR}/planet.osm.bz2"
LOCK_FILE=/db/update-poi-db.lock

PLANET_URL=${OVERPASS_PLANET_URL:-}

# A whole continent in one file is what gets a small server OOM killed, hours
# in and 35 GB down. With this set the extract is built out of the countries in
# the list instead, one at a time, and nothing here ever holds more than the
# largest of them. See bin/build-region-extract
REGION_LIST=${WAYSIDE_REGION_LIST:-}

# Which container to restart once the new database is in place, for the layout
# where building and serving are two containers and this one cannot reach the
# other's supervisor. Needs the Docker socket mounted here. Empty when the
# server is in this same container, which is the case the supervisor branch
# below handles on its own
RESTART_CONTAINER=${WAYSIDE_RESTART_CONTAINER:-}
DOCKER_SOCKET=${WAYSIDE_DOCKER_SOCKET:-/var/run/docker.sock}

SKIP_DOWNLOAD=false
KEEP_EXTRACT=false

for arg in "$@"; do
	case "$arg" in
	--url=*) PLANET_URL="${arg#--url=}" ;;
	--regions=*) REGION_LIST="${arg#--regions=}" ;;
	--skip-download) SKIP_DOWNLOAD=true ;;
	--keep-extract) KEEP_EXTRACT=true ;;
	-h | --help)
		cat <<-'USAGE'
			Usage: update-poi-db [--url=URL] [--regions=FILE] [--skip-download] [--keep-extract]

			Rebuilds the database from a fresh OpenStreetMap extract, filtered to
			the tags the app queries. The live database keeps answering until the
			new one is ready.

			  --url=URL        extract to import, default $OVERPASS_PLANET_URL
			  --regions=FILE   build the extract from a region list instead of one URL
			  --skip-download  reuse the extract left by a previous run
			  --keep-extract   do not delete the extract afterwards
		USAGE
		exit 0
		;;
	*)
		echo "update-poi-db: unknown argument $arg" >&2
		exit 1
		;;
	esac
done

if [[ -z $PLANET_URL && -z $REGION_LIST && $SKIP_DOWNLOAD == false ]]; then
	echo "update-poi-db: no extract to import. Set OVERPASS_PLANET_URL or WAYSIDE_REGION_LIST," >&2
	echo "update-poi-db: or pass --url= or --regions=" >&2
	exit 1
fi
if [[ -n $REGION_LIST && ! -s $REGION_LIST ]]; then
	echo "update-poi-db: region list $REGION_LIST is missing or empty" >&2
	exit 1
fi

# An import is hours of CPU and a second copy of the database on disk. Two at
# once would race over the same directories and fill the volume
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
	echo "update-poi-db: another update is already running" >&2
	exit 1
fi

log() { echo "update-poi-db: $(date '+%F %T') $*"; }

# Settings the live database was built with. Reading the same variables the
# entrypoint reads is what keeps the replacement readable by the same server
OVERPASS_META=${OVERPASS_META:-no}
OVERPASS_COMPRESSION=${OVERPASS_COMPRESSION:-gz}
OVERPASS_FLUSH_SIZE=${OVERPASS_FLUSH_SIZE:-16}
OVERPASS_USE_AREAS=${OVERPASS_USE_AREAS:-true}

if [[ $OVERPASS_META == "attic" ]]; then
	META="--keep-attic"
elif [[ $OVERPASS_META == "yes" ]]; then
	META="--meta"
else
	META=""
fi

STARTED=$(date +%s)
mkdir -p "$WORK_DIR"
rm -rf "$NEW_DB"

if [[ $SKIP_DOWNLOAD == true ]]; then
	if [[ ! -s $EXTRACT ]]; then
		echo "update-poi-db: --skip-download but $EXTRACT is missing." >&2
		echo "update-poi-db: only a run given --keep-extract leaves one behind" >&2
		exit 1
	fi
	log "reusing $EXTRACT"
elif [[ -n $REGION_LIST ]]; then
	# Downloads, filters and merges the regions itself, and leaves a
	# .timestamp beside the result so the import below does not have to
	# decompress the whole thing again to date it
	log "building the extract from $REGION_LIST"
	build-region-extract --list="$REGION_LIST" "$EXTRACT"
else
	log "downloading $PLANET_URL"
	curl -fL --retry 3 --retry-delay 30 -o "$EXTRACT" "$PLANET_URL"
	log "filtering"
	filter-osm-extract "$EXTRACT"
fi

# How current the data is, which Overpass reports back in every answer.
# `fileinfo -e` reads every object to work it out, and on a bzip2 Europe that
# is a full decompress for one timestamp. build-region-extract already took it
# from the region headers, so use that when it is there
if [[ -s "${EXTRACT}.timestamp" ]]; then
	VERSION=$(cat "${EXTRACT}.timestamp")
	log "data is current as of $VERSION"
else
	log "reading the extract's timestamp"
	VERSION=$(osmium fileinfo -e -g data.timestamp.last "$EXTRACT")
fi

log "importing into $NEW_DB (the live database keeps answering)"
mkdir -p "$NEW_DB"
/app/bin/init_osm3s.sh "$EXTRACT" "$NEW_DB" /app "$META" \
	"--version=${VERSION} --compression-method=${OVERPASS_COMPRESSION} --map-compression-method=${OVERPASS_COMPRESSION} --flush-size=${OVERPASS_FLUSH_SIZE}"
cp -r /app/etc/rules "$NEW_DB"
chown -R overpass:overpass "$WORK_DIR"

# The dispatcher holds the live database open and puts its socket inside it,
# so it has to be down while the directories change places. Supervisor restarts
# it on its own if it dies, which is why it is stopped properly rather than
# killed.
#
# The config lives where the image put it, which is not one of the paths
# supervisorctl looks in on its own
SUPERVISORCTL=(supervisorctl -c /etc/supervisor/conf.d/supervisord.conf)
UNDER_SUPERVISOR=false
# `version` and not `status`: status answers 3 when any program is stopped,
# which here only means areas are switched off
if "${SUPERVISORCTL[@]}" version >/dev/null 2>&1; then
	UNDER_SUPERVISOR=true
	log "stopping the dispatcher"
	"${SUPERVISORCTL[@]}" stop overpass_dispatch dispatcher_areas >/dev/null || true
	# A stopped dispatcher leaves its shared memory file behind, and the next
	# one refuses to start on top of it:
	#   File_Error File exists 17 /osm3s_osm_base Dispatcher_Server::1
	# The entrypoint clears the same thing for the areas dispatcher on boot
	rm -f /dev/shm/osm3s_osm_base /dev/shm/osm3s_areas
fi

log "swapping the database in"
rm -rf "${DB_DIR}.old"
if [[ -d $DB_DIR ]]; then
	mv "$DB_DIR" "${DB_DIR}.old"
fi
mv "$NEW_DB" "$DB_DIR"
touch /db/init_done

if [[ $UNDER_SUPERVISOR == true ]]; then
	log "starting the dispatcher"
	if ! "${SUPERVISORCTL[@]}" start overpass_dispatch >/dev/null; then
		echo "update-poi-db: the dispatcher did not come back up." >&2
		echo "update-poi-db: the database that was live is still at ${DB_DIR}.old" >&2
		exit 1
	fi
	if [[ $OVERPASS_USE_AREAS == "true" ]]; then
		"${SUPERVISORCTL[@]}" start dispatcher_areas >/dev/null || true
		# Through the dispatcher, on the database that is now live, the way
		# rules_loop.sh does it. Building them beside the live database instead
		# would have two processes fighting over one shared memory file
		log "generating areas"
		/app/bin/osm3s_query --progress --rules <"${DB_DIR}/rules/areas.osm3s"
	fi
	SERVER_RELOADED=true
else
	# Nothing to stop here, because the server is in another container: this
	# one only builds. It has been answering from the old directory all along
	# and, having opened those files at boot, it goes on answering from them
	# after the rename. Only a restart makes it look at the new database
	SERVER_RELOADED=false
	if [[ -n $RESTART_CONTAINER ]]; then
		log "restarting $RESTART_CONTAINER to pick up the new database"
		# The Docker API over the mounted socket, because the docker CLI is not
		# in this image and curl is. 204 is the documented success
		STATUS=$(curl -s -o /dev/null -w '%{http_code}' --unix-socket "$DOCKER_SOCKET" \
			-X POST "http://localhost/containers/${RESTART_CONTAINER}/restart?t=30" || echo 000)
		if [[ $STATUS == "204" ]]; then
			SERVER_RELOADED=true
		else
			echo "update-poi-db: could not restart $RESTART_CONTAINER, Docker answered $STATUS" >&2
		fi
	fi
fi

# The old database goes only once nothing is reading it any more. A server that
# has not been restarted still has these files open, and deleting them under it
# leaves it answering until the first query that needs a file it can no longer
# open. Leaving the directory behind costs disk and nothing else
if [[ $SERVER_RELOADED == true ]]; then
	rm -rf "${DB_DIR}.old"
else
	log "leaving the previous database at ${DB_DIR}.old until the server has restarted"
fi

if [[ $KEEP_EXTRACT == true ]]; then
	log "extract kept at $EXTRACT"
else
	rm -rf "$WORK_DIR"
fi

log "done in $((($(date +%s) - STARTED) / 60)) min, database is $(du -sh "$DB_DIR" | cut -f1)"

if [[ $SERVER_RELOADED == false ]]; then
	echo "update-poi-db: the new database is in place, but the server is still answering"
	echo "update-poi-db: from the old one. Restart the Overpass container, then remove"
	echo "update-poi-db: ${DB_DIR}.old"
fi
