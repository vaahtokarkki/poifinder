# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# Which OSM extracts to build from. Whitespace separated; any Geofabrik file
# works. A city is built when its centre falls inside an extract's header
# bounding box, so this list is what decides which of the 36 cities in
# cities.json get tiles — and a city with no tiles simply has no noise layer,
# which the frontend handles by showing nothing.
#
# The default is Finland alone (~700 MB, covers Helsinki), because a first run
# that quietly downloads 20 GB is not a good first run.
NOISE_EXTRACTS=https://download.geofabrik.de/europe/finland-latest.osm.pbf

# Every tier 1 European city, one country at a time (~20 GB, 21 cities):
#   NOISE_EXTRACTS="https://download.geofabrik.de/europe/finland-latest.osm.pbf https://download.geofabrik.de/europe/sweden-latest.osm.pbf ..."
# See europe.txt, which is that list; the compose file reads this variable
# rather than the file, so paste it in or generate it:
#   NOISE_EXTRACTS="$(grep -v '^#' europe.txt | tr '\n' ' ')" docker compose run --rm builder build-noise-tiles

# Host port the development tile server listens on. Whatever this is,
# VITE_NOISE_TILES_URL in apps/frontend/.env has to match
NOISE_TILES_PORT=8080

# The zoom range tiles are written for. The client overzooms above the maximum
# rather than fetching more, which for three smooth polygons is free: a z12
# tile carries about 1.5 m of resolution, far finer than a band edge that was
# modelled rather than measured.
#
# Raising the maximum multiplies the tile count by four per level. At 10-12 the
# 36 tier 1 cities come to roughly 350 files; at 15 it is 18,000, which is the
# point where a static host's file count starts to matter
NOISE_MIN_ZOOM=10
NOISE_MAX_ZOOM=12
