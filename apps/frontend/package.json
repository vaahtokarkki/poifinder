{
  "name": "@wayside/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://wayside.cc",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b --noCheck && vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "seo:data": "node scripts/fetch-poi-data.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "overpass:filters": "node scripts/generate-osmium-filter.mjs",
    "noise:cities": "node scripts/generate-noise-cities.mjs",
    "basemap:import": "node scripts/import-basemap-style.mjs",
    "basemap:sprite": "node scripts/build-basemap-sprite.mjs",
    "lint": "gts lint",
    "preview": "vite preview",
    "clean": "gts clean",
    "compile": "tsc --noCheck ",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.1.2",
    "@turf/turf": "^7.2.0",
    "axios": "^1.10.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^5.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-select": "^5.10.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.7.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "gts": "^6.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "wrangler": "^4.118.0"
  }
}
