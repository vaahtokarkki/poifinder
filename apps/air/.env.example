# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# The OpenAQ key. Free, instant, and the only thing here without a default:
# register at https://explore.openaq.org/register.
#
# The free tier is 60 requests a minute and 2,000 an hour. An hourly build uses
# five or six of them, because one paginated endpoint returns every current
# PM2.5 reading on the planet — which is the reason this app has no tile cache
# and no request-time fetching anywhere in it. See the header of bin/air-latest.
OPENAQ_API_KEY=

# What gets published, as west,south,east,north in degrees. Empty is the whole
# world, which the pipeline is perfectly happy to build — the fetch is one call
# either way and a global field costs about three minutes.
#
# The box never restricts the interpolation, only the output. Stations outside
# it still shape the field inside it, because air crosses borders and a build
# that dropped foreign monitors would draw a false gradient along every one of
# them. See the header of bin/build-air-tiles.
#
# Germany, the same box the Geofabrik extract carries, which is what
# apps/noise builds its German cities from:
AIR_BBOX=5.87,47.27,15.04,55.15

# Host port the development tile server listens on. Whatever this is,
# VITE_AIR_TILES_URL in apps/frontend/.env has to match. 8081 rather than 8080
# so that this and apps/noise can both be up at once
AIR_TILES_PORT=8081

# The zoom range tiles are written for, and the client overzooms above the
# maximum. Low, and not as a compromise: the field is interpolated from
# stations tens of kilometres apart, so it has no detail below a few kilometres
# to write tiles for. Tiles that stop at z8 are telling the truth about their
# own resolution.
#
# Raising the maximum multiplies the tile count by four per level, and unlike
# the noise layer this one is global — z12 would be hundreds of thousands of
# files describing a surface that has not changed since z8
AIR_MIN_ZOOM=2
AIR_MAX_ZOOM=8

# The grid the interpolation is sampled on, in degrees. 0.1 is about 11 km,
# which is finer than the field it samples: with stations tens of kilometres
# apart and a 150 km influence radius, the surface has no features smaller than
# that. 0.05 costs four times the memory (about 440 MB) and produces a
# perceptibly identical map
AIR_GRID_DEGREES=0.1

# How far a station's reading shapes the field, and how far anything is drawn
# at all. Two radii rather than one: stations out to AIR_INFLUENCE_KM are
# averaged into a cell, so a cell near the edge of coverage is still informed
# by several monitors, but nothing is drawn past AIR_MASK_KM of a station
# however confident the arithmetic was.
#
# AIR_MASK_KM is the honest part of this whole app. Raise it and the map starts
# colouring in places nobody measures; the interpolation will not object,
# because interpolation always produces a value
AIR_INFLUENCE_KM=150
AIR_MASK_KM=75

# Readings older than this are dropped before anything is built. Not a tuning
# knob: "latest" in the OpenAQ API means the last value in a sensor's series,
# not a recent one, so a monitor that stopped reporting in 2019 still has a
# latest value and will sit in the middle of a country pulling the
# interpolation toward the air of a day long gone
AIR_MAX_AGE_HOURS=6
