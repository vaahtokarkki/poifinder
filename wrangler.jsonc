{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayside",
  "compatibility_date": "2026-01-01",

  // Static-only Worker: no "main" entrypoint, Cloudflare serves ./dist directly.
  // The app is a client-side SPA with real paths (/helsinki/playgrounds), so
  // unmatched routes must fall back to index.html instead of a 404.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // wayside.cc must already exist as a zone in this Cloudflare account.
  // Wrangler creates and points the DNS record itself on first deploy.
  "routes": [
    { "pattern": "wayside.cc", "custom_domain": true }
    // Uncomment to also serve the www subdomain:
    // { "pattern": "www.wayside.cc", "custom_domain": true }
  ]
}