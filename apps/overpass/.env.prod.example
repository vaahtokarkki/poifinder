# Copy to .env next to docker-compose.prod.yml. Compose reads it automatically.
# Everything else about this deployment stays written into that file; these
# two are here because they differ by machine.

# Where the live database lives, mounted at /db in both the overpass and
# importer services. A path on the host, not a named volume, so it is
# somewhere you can point df at, back up, or move to a bigger disk
OVERPASS_DATA_DIR=/mnt/hdd1/wayside

# Where update-poi-db writes the download, the filter pass and the region
# cache — most of an import's disk I/O. Point this at a different, cheaper
# disk than OVERPASS_DATA_DIR to keep that churn off the disk the server
# reads from; the finished database is copied over, not built in place. The
# same path as OVERPASS_DATA_DIR is fine on a single disk box
OVERPASS_CACHE_DIR=/mnt/hdd1/wayside
