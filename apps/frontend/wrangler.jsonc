{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayside",
  "compatibility_date": "2026-01-01",

  // Static-only Worker: no "main" entrypoint, Cloudflare serves ./dist directly.
  //
  // Every real path (/helsinki/toilets) is prerendered to its own index.html by
  // scripts/prerender.mjs, so there is nothing left for an SPA fallback to do.
  // Serving the shell for anything else would make every typo a 200, which is
  // an unbounded supply of soft 404s for a crawler to work through.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },

  // wayside.cc must already exist as a zone in this Cloudflare account.
  // Wrangler creates and points the DNS record itself on first deploy.
  //
  // www is here because the zone already has a proxied DNS record for it and
  // nothing was answering behind it: every www URL returned 522, Cloudflare's
  // "no origin". A hostname people type by habit has to resolve to something.
  //
  // It serves the same files as the apex rather than redirecting, because a
  // static-assets Worker has no code in it to redirect with. That is two
  // hostnames answering with identical HTML, which is only safe because every
  // canonical, og:url, sitemap entry and internal link in it is absolute and
  // points at the apex — see SITE_URL in src/seo/pageMeta.ts. A crawler that
  // arrives at www is told where the page really lives and folds the two.
  //
  // The tidier finish is a Cloudflare Redirect Rule, 301 from www to the apex.
  // It runs at the edge before any of this, costs no Worker code, and means
  // the duplicate hostname never serves a page at all. Add it in the dashboard
  // under Rules -> Redirect Rules; this entry can stay either way.
  "routes": [
    { "pattern": "wayside.cc", "custom_domain": true },
    { "pattern": "www.wayside.cc", "custom_domain": true }
  ]
}