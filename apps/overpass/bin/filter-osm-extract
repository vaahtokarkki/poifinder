#!/bin/bash
#
# Cut an OpenStreetMap extract down to the objects the app can ask for.
#
#   filter-osm-extract [FILE]           replace FILE, in place, with bzip2 XML
#   filter-osm-extract SRC DEST         read SRC, write DEST, format from DEST
#
# The result holds only the objects carrying one of the tags in
# osmium-filter.txt, plus the nodes those objects are built from, which
# Overpass needs to place a way or a relation on the map.
#
# And, unless WAYSIDE_JOIN_BUILDINGS says otherwise, the buildings those points
# stand in: a toilet in a shopping centre is a node with `amenity=toilets` and
# nothing else on it, and everything else worth knowing about it — the centre's
# name, its address, its outline on the map — belongs to a building the filter
# would otherwise drop. See bin/join-buildings.
#
# The one argument form is what the container entrypoint expects: it hands us
# /db/planet.osm.bz2 (whatever OVERPASS_PLANET_URL actually pointed at) and
# then feeds the same path to bunzip2, so a real .osm.bz2 has to come back.
#
# The two argument form is for build-region-extract, which filters fifty
# country extracts in a row and wants each result as a .osm.pbf: bzip2 is the
# slowest thing here by a wide margin and there is no reason to pay for it on
# an intermediate file that osmium merge is about to read straight back.
#
# Used from three places: OVERPASS_PLANET_PREPROCESS on the first import,
# update-poi-db on every refresh, and build-region-extract once per region.
# All of them must filter identically, which is the reason this is one script
# rather than a line of shell in the compose file.
#
# Memory: without --omit-referenced, osmium builds an index of every node id a
# matched way refers to, and that index is sized by the largest id in the file
# rather than by how many are kept. It is the reason a whole continent in one
# file is what gets a small server OOM killed, and the reason for
# build-region-extract.

set -euo pipefail

FILTER_FILE=${WAYSIDE_FILTER_FILE:-/opt/wayside/osmium-filter.txt}

# Whether to put the buildings the points stand in back into the extract. On
# for everyone, because a toilet the app cannot name the building of is most of
# a toilet nobody finds. Turn it off on a machine where the extra pass over the
# extract, or the copy of its buildings on the disk while it runs, is the thing
# that will not fit
JOIN_BUILDINGS=${WAYSIDE_JOIN_BUILDINGS:-true}

# Whether to keep the named streets. On for everyone, for the same reason the
# buildings are: most of what this site maps carries no name of its own, and the
# street it stands on is what places it. See `placedByStreet` in
# apps/frontend/src/seo/categories.ts, which is the consumer.
#
# Unlike the buildings this needs no geometry pass. A street is kept because it
# is a named road, not because a point stands on it, so two tag filters do the
# whole job — and there is nothing to be gained by being cleverer: the points
# this database holds are dense enough that nearly every urban street is within
# thirty metres of one, so selecting by proximity would drop rural roads and
# little else, for a spatial join's worth of new code.
#
# On Bremen it takes the extract from 0.6 MB to 2.6 MB, against a 21 MB source.
JOIN_STREETS=${WAYSIDE_JOIN_STREETS:-true}

if [[ $# -ge 2 ]]; then
	SOURCE=$1
	TARGET=$2
	IN_PLACE=false
else
	TARGET=${1:-/db/planet.osm.bz2}
	SOURCE="${TARGET}.raw"
	IN_PLACE=true
fi

if [[ ! -s $FILTER_FILE ]]; then
	echo "filter-osm-extract: $FILTER_FILE is missing or empty" >&2
	exit 1
fi

if [[ $IN_PLACE == true ]]; then
	if [[ ! -s $TARGET ]]; then
		echo "filter-osm-extract: $TARGET is missing or empty" >&2
		exit 1
	fi
	mv -f "$TARGET" "$SOURCE"
elif [[ ! -s $SOURCE ]]; then
	echo "filter-osm-extract: $SOURCE is missing or empty" >&2
	exit 1
fi

# osmium takes the format from the file name, and the input here rarely has one
# worth trusting: in place we have just renamed it, and a download is named
# after its region rather than its format. Read the magic bytes instead
case "$(od -An -tx1 -N4 "$SOURCE" | tr -d ' \n')" in
425a68*) FORMAT=osm.bz2 ;; # "BZh"
1f8b*) FORMAT=osm.gz ;;
3c*) FORMAT=osm ;; # "<", uncompressed XML
*) FORMAT=pbf ;;
esac

# In place has to come back as the .osm.bz2 the entrypoint will bunzip2. With
# an explicit destination the name says what it wants, and osmium reads it
if [[ $IN_PLACE == true ]]; then
	OUTPUT_FORMAT=(--output-format=osm.bz2)
	OUTPUT_LABEL="bzip2 XML"
else
	OUTPUT_FORMAT=()
	OUTPUT_LABEL="${TARGET##*/}"
fi

BEFORE=$(stat -c %s "$SOURCE")
echo "filter-osm-extract: filtering $(numfmt --to=iec "$BEFORE") of $FORMAT with $FILTER_FILE"

# With the join on, the filter writes somewhere else and the join writes the
# target, out of that and the buildings it goes back to the source for. pbf in
# between whatever the target is: it is read twice more before it is the answer,
# and bzip2 is the slowest thing in this script by a wide margin
if [[ $JOIN_BUILDINGS == true ]]; then
	FILTERED="${TARGET}.filtered.osm.pbf"
	FILTER_OUTPUT=(--output-format=pbf --output="$FILTERED")
	trap 'rm -f "$FILTERED"' EXIT
else
	FILTERED="$TARGET"
	FILTER_OUTPUT=("${OUTPUT_FORMAT[@]}" --output="$TARGET")
fi

osmium tags-filter \
	--verbose \
	--overwrite \
	--input-format="$FORMAT" \
	"${FILTER_OUTPUT[@]}" \
	--expressions="$FILTER_FILE" \
	"$SOURCE"

if [[ $JOIN_BUILDINGS == true ]]; then
	join-buildings \
		--source="$SOURCE" \
		--source-format="$FORMAT" \
		--pois="$FILTERED" \
		--expressions="$FILTER_FILE" \
		--output="$TARGET" \
		"${OUTPUT_FORMAT[@]}"
	rm -f "$FILTERED"
	trap - EXIT
fi

# The named streets, in two passes because osmium tags-filter ORs its
# expressions and what is wanted here is an AND. The first keeps every highway
# with the nodes it is drawn from; the second keeps, out of those, the ones
# carrying a name — and because its input is already only highways, a named way
# in it is a named road. Doing it the other way round would pull every named
# object in the extract through the first pass.
#
# The merge is last so that it runs over whatever the buildings step produced,
# and it carries the header across itself: osmium merge writes its own
# otherwise, and the timestamp in it is what the container reports to every
# client as the age of its data.
if [[ $JOIN_STREETS == true ]]; then
	# The merged file is written under the target's own basename, in a
	# directory beside it. osmium takes the format from the name, and this way
	# the name is the target's — so both call shapes get the format they
	# already asked for without the format having to be worked out again
	# dirname, not ${TARGET%/*}: a bare filename has no slash to strip, and
	# that expansion returns the filename itself, which is not a directory
	STREET_WORK=$(mktemp -d "$(dirname "$TARGET")/filter-osm-extract.XXXXXX")
	ROADS="$STREET_WORK/roads.osm.pbf"
	NAMED="$STREET_WORK/named.osm.pbf"
	MERGED="$STREET_WORK/${TARGET##*/}"
	trap 'rm -rf "$STREET_WORK"' EXIT

	echo "filter-osm-extract: pulling the named streets out of the extract"
	osmium tags-filter \
		--overwrite \
		--input-format="$FORMAT" \
		--output="$ROADS" \
		"$SOURCE" \
		w/highway
	osmium tags-filter \
		--overwrite \
		--output="$NAMED" \
		"$ROADS" \
		w/name
	rm -f "$ROADS"

	# osmium merge writes its own header, and the timestamp in it is what the
	# container reports to every client as the age of its data. Carry the
	# target's across rather than letting the merge date the database today
	HEADER=()
	for OPTION in osmosis_replication_timestamp osmosis_replication_sequence_number osmosis_replication_base_url; do
		VALUE=$(osmium fileinfo -e -g "header.option.$OPTION" "$TARGET" 2>/dev/null || true)
		if [[ -n $VALUE ]]; then
			HEADER+=(--output-header "$OPTION=$VALUE")
		fi
	done

	osmium merge \
		--overwrite \
		--output="$MERGED" \
		"${HEADER[@]}" \
		"$TARGET" \
		"$NAMED"
	mv -f "$MERGED" "$TARGET"
	rm -rf "$STREET_WORK"
	trap - EXIT
fi

AFTER=$(stat -c %s "$TARGET")
echo "filter-osm-extract: $(numfmt --to=iec "$BEFORE") -> $(numfmt --to=iec "$AFTER") ($OUTPUT_LABEL)"

if [[ $IN_PLACE == true ]]; then
	rm -f "$SOURCE"
fi
