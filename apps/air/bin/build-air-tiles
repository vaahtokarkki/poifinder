#!/usr/bin/env bash
#
# Build the air quality tiles, from OpenAQ to a directory of .pbf tiles.
#
#   build-air-tiles                        fetch, interpolate, tile
#   build-air-tiles --cities=berlin        publish only these cities
#   build-air-tiles --buffer-km=10         how far past a boundary to publish
#   build-air-tiles --point-buffer-km=20   how far past a boundary-less point
#   build-air-tiles --stations=FILE        reuse a snapshot instead of fetching
#   build-air-tiles --keep-work            leave the intermediate files behind
#
# Three steps and no arguments in the ordinary case, which is the difference
# between this and the noise builder next door. That one takes a list of areas
# because it models cities one at a time out of 20 GB of extracts; this one
# always does the same thing, because the input is one global snapshot of a few
# thousand numbers and there is no smaller useful unit of it.
#
#   1. air-latest    every current PM2.5 reading OpenAQ has
#   2. air-field     inverse distance weighting, contoured, masked to coverage
#   3. tippecanoe    the same z/x/y.pbf shape apps/noise writes
#
# WHAT GETS PUBLISHED, AND WHAT GETS READ
#
# Published: the administrative boundaries of the cities in --cities, buffered
# outwards by --buffer-km. A city is not a circle — see load_boundary in
# air-field — and ten kilometres past the line is roughly where somebody stops
# thinking of themselves as being in the city.
#
# Read: everything within the influence radius of that, which is a much larger
# box. Stations outside the published area still shape the field inside it,
# because air crosses boundaries and a build that dropped the monitors just
# over the line would draw a false gradient along it.
#
# Both are clamped to Europe by air-latest, and that limit is about licensing
# rather than geography. See its header.
#
# Output goes to $AIR_TILE_DIR/current, holding the tiles and stations.json —
# the snapshot the field was built from, which the client fetches to put a
# measured number in a popup rather than an interpolated one.
#
# `current` is a symlink and that is the whole deployment story, exactly as it
# is for the noise tiles: a build writes a new directory beside it and moves
# the link only when it has finished, so an hourly job that fails at the fetch
# leaves the last good tiles being served, and the swap is one atomic rename
# rather than files appearing under a reader one at a time.
#
# That failure mode is the reason this runs hourly without supervision. OpenAQ
# is a free service aggregating several hundred government feeds; it has
# outages, and so do they. A failed run here is a map that is an hour stale,
# which is inside what the caption already promises, rather than a map that is
# empty.

set -euo pipefail

TILE_DIR="${AIR_TILE_DIR:-/tiles}"
WORK_DIR="${AIR_WORK_DIR:-/tmp/air-work}"
MIN_ZOOM="${AIR_MIN_ZOOM:-2}"
MAX_ZOOM="${AIR_MAX_ZOOM:-8}"

# The three numbers the model is. See air-field for what each one does and why
# the mask is the one that matters
GRID_DEGREES="${AIR_GRID_DEGREES:-0.1}"
INFLUENCE_KM="${AIR_INFLUENCE_KM:-150}"
MASK_KM="${AIR_MASK_KM:-75}"

# Readings older than this are dropped. Not a tuning knob — see the header of
# air-latest for why a build without it is wrong rather than stale
MAX_AGE_HOURS="${AIR_MAX_AGE_HOURS:-6}"

# Which cities to publish, by slug from the boundaries file. Empty is every
# boundary in it
CITIES="${AIR_CITIES:-}"

# How far past each city's administrative line to publish
BUFFER_KM="${AIR_BUFFER_KM:-10}"

# How far past a city's *point* to publish, for the handful with no boundary
# at all — see load_boundary in air-field for why this is wider than BUFFER_KM
POINT_BUFFER_KM="${AIR_POINT_BUFFER_KM:-20}"

# The boundaries themselves, baked into the image beside the scripts
BOUNDARY_FILE="${AIR_BOUNDARY_FILE:-/opt/wayside/boundaries.geojson}"

KEEP_WORK=false
STATIONS_IN=""
for argument in "$@"; do
  case "$argument" in
    --keep-work) KEEP_WORK=true ;;
    # A snapshot from an earlier run. The whole point is looking at a change to
    # the model without spending a fetch on it — the field is deterministic
    # given the stations, so the same file gives the same tiles
    --stations=*) STATIONS_IN="${argument#--stations=}" ;;
    --cities=*) CITIES="${argument#--cities=}" ;;
    --buffer-km=*) BUFFER_KM="${argument#--buffer-km=}" ;;
    --point-buffer-km=*) POINT_BUFFER_KM="${argument#--point-buffer-km=}" ;;
    --*) echo "unknown option: $argument" >&2; exit 2 ;;
    *) echo "unexpected argument: $argument" >&2; exit 2 ;;
  esac
done

log() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" >&2; }

mkdir -p "$TILE_DIR" "$WORK_DIR"
if [ "$KEEP_WORK" = false ]; then
  # The contents, not the directory: WORK_DIR can be a mount point, and
  # removing one fails with "Device or resource busy" — the same trap the
  # noise builder documents
  trap 'rm -rf "${WORK_DIR:?}/"* "${WORK_DIR:?}/".[!.]* 2>/dev/null || true' EXIT
fi

STATIONS="$WORK_DIR/stations.json"
BANDS="$WORK_DIR/bands.geojson"

[ -s "$BOUNDARY_FILE" ] || { echo "no boundaries file: $BOUNDARY_FILE" >&2; exit 2; }

# Two boxes out of the boundaries: what is published, and what is read to build
# it. Worked out here in one place so the fetch and the field cannot disagree
# about where the edges are
read -r PUBLISH_BBOX INGEST_BBOX <<EOF
$(python3 - "$BOUNDARY_FILE" "${CITIES:-}" "$BUFFER_KM" "$POINT_BUFFER_KM" "$INFLUENCE_KM" <<'BOX'
import json, math, sys

path, cities, buffer_km, point_buffer_km, influence_km = (
    sys.argv[1], sys.argv[2], float(sys.argv[3]), float(sys.argv[4]), float(sys.argv[5])
)
# The wider of the two margins, since a handful of features are published from
# a point at point_buffer_km rather than from an outline at buffer_km, and this
# box only has to be generous enough to cover whichever one applies
margin_km = max(buffer_km, point_buffer_km)
features = json.load(open(path))["features"]
if cities.strip():
    wanted = {c.strip() for c in cities.split(",") if c.strip()}
    features = [f for f in features if f["properties"].get("slug") in wanted]
    missing = wanted - {f["properties"].get("slug") for f in features}
    if missing:
        sys.exit(f"no boundary named {', '.join(sorted(missing))} in {path}")
if not features:
    sys.exit("no boundary selected")

def bounds(geometry):
    xs, ys = [], []
    def walk(node):
        if isinstance(node, (int, float)):
            return
        if len(node) == 2 and all(isinstance(v, (int, float)) for v in node):
            xs.append(node[0]); ys.append(node[1]); return
        for child in node:
            walk(child)
    walk(geometry["coordinates"])
    return min(xs), min(ys), max(xs), max(ys)

west = south = east = north = None
for feature in features:
    w, s, e, n = bounds(feature["geometry"])
    west = w if west is None else min(west, w)
    south = s if south is None else min(south, s)
    east = e if east is None else max(east, e)
    north = n if north is None else max(north, n)

def widen(box, km):
    w, s, e, n = box
    dlat = km / 110.574
    worst = min(max(abs(s), abs(n)), 85.0)
    dlon = km / (111.320 * max(math.cos(math.radians(worst)), 0.15))
    return (max(-180.0, w - dlon), max(-90.0, s - dlat),
            min(180.0, e + dlon), min(90.0, n + dlat))

fmt = lambda b: ",".join(f"{v:.4f}" for v in b)
print(fmt(widen((west, south, east, north), margin_km)),
      fmt(widen((west, south, east, north), margin_km + influence_km)))
BOX
)
EOF
[ -n "$INGEST_BBOX" ] || { echo "could not work out the build area" >&2; exit 1; }

# ------------------------------------------------------------------ the fetch

if [ -n "$STATIONS_IN" ]; then
  [ -s "$STATIONS_IN" ] || { echo "no such snapshot: $STATIONS_IN" >&2; exit 2; }
  log "stations: reusing $STATIONS_IN"
  cp "$STATIONS_IN" "$STATIONS"
else
  log "fetch: PM2.5 within $INGEST_BBOX, at most ${MAX_AGE_HOURS}h old"
  air-latest --output="$STATIONS" --max-age="$MAX_AGE_HOURS" --bbox="$INGEST_BBOX"
fi

# ------------------------------------------------------------------ the field

log "field: ${GRID_DEGREES}° grid, ${INFLUENCE_KM} km influence, ${MASK_KM} km mask, ${BUFFER_KM} km (${POINT_BUFFER_KM} km for a point) past ${CITIES:-every boundary}"
air-field \
  --stations="$STATIONS" \
  --output="$BANDS" \
  --grid="$GRID_DEGREES" \
  --influence-km="$INFLUENCE_KM" \
  --mask-km="$MASK_KM" \
  --boundary="$BOUNDARY_FILE" \
  --buffer-km="$BUFFER_KM" \
  --point-buffer-km="$POINT_BUFFER_KM" \
  ${CITIES:+--cities="$CITIES"}

# ------------------------------------------------------------------ the tiles

log "tippecanoe: z$MIN_ZOOM-z$MAX_ZOOM"

STAMP=$(date -u +%Y%m%d-%H%M%S)
STAGING="$TILE_DIR/build-$STAMP"
rm -rf "$STAGING"

# Gzipped, which is tippecanoe's default and why there is no
# --no-tile-compression: Caddy serves the bytes as they lie with
# `Content-Encoding: gzip` set statically, so the compression happens once here
# rather than per request. apps/noise measured that trade and this follows it.
#
# The size and feature limits are off for the same reason they are off there.
# This is six large multipolygons, one per band; there is nothing tippecanoe
# could usefully drop, and a band dropped to fit a tile budget is a city that
# reads as clean air because its polygon did not survive.
#
# --detail 13 rather than the default 12. The client overzooms from z8 to
# wherever the reader is, which is a much longer stretch than the noise layer
# asks for, and the extra bit of coordinate precision is what keeps a band edge
# from arriving as a visible staircase when one crosses the screen.
tippecanoe \
  --output-to-directory="$STAGING" \
  --layer=air \
  --minimum-zoom="$MIN_ZOOM" \
  --maximum-zoom="$MAX_ZOOM" \
  --full-detail=13 \
  --no-tile-size-limit \
  --no-feature-limit \
  --drop-rate=0 \
  --simplification=2 \
  --quiet \
  --force \
  "$BANDS"

# Beside the tiles, gzipped like them so Caddy can serve the whole directory
# with one Content-Encoding. This is what the popup reads: the client works out
# the nearest station itself rather than asking the tiles what band a point is
# in, so that a popup can say "18 µg/m³, 12 km away" — a measurement and its
# distance — instead of the interpolated colour underneath it
PUBLISHED="$WORK_DIR/stations.published.json"
python3 - "$STATIONS" "$PUBLISHED" "$MASK_KM" "$BOUNDARY_FILE" "${CITIES:-}" "$BUFFER_KM" "$POINT_BUFFER_KM" <<'TRIM'
import json, math, sys

from shapely.geometry import shape
from shapely.ops import transform, unary_union

source, destination = sys.argv[1], sys.argv[2]
mask_km = float(sys.argv[3])
boundary_path, cities, buffer_km, point_buffer_km = (
    sys.argv[4], sys.argv[5], float(sys.argv[6]), float(sys.argv[7])
)

with open(source) as handle:
    snapshot = json.load(handle)
rows = snapshot["stations"]

# Trimmed to the published shape rather than to a box around it, and for a
# set scattered from Reykjavik to Yerevan that is the whole difference. A box
# around all of it is the whole of Europe, which would keep every station on
# the continent and have the client download all of them to answer one popup.
features = json.load(open(boundary_path))["features"]
if cities.strip():
    wanted = {slug.strip() for slug in cities.split(",") if slug.strip()}
    features = [f for f in features if f["properties"].get("slug") in wanted]

# Each feature buffered in its own local frame and by its own radius, then
# unioned — the same approach load_boundary in air-field takes, and for the
# same two reasons: a shared frame gets the buffer wrong everywhere but its
# centre, and a feature published from a point rather than an outline (see
# fetch-boundaries) is published at point_buffer_km, not buffer_km.
#
# Buffered by the published radius plus the mask radius: a popup just inside
# the published edge may legitimately quote a monitor just outside it, and
# dropping that station would replace a nearby reading with a distant one
buffered = []
for feature in features:
    is_point = (feature.get("properties") or {}).get("boundaryType") == "point"
    radius = (point_buffer_km if is_point else buffer_km) + mask_km
    geometry = shape(feature["geometry"])
    lat0 = math.radians(geometry.centroid.y)
    scale = max(math.cos(lat0), 0.05)
    to_km = lambda x, y, scale=scale: (x * 111.320 * scale, y * 110.574)
    to_degrees = lambda x, y, scale=scale: (x / (111.320 * scale), y / 110.574)
    buffered.append(transform(to_degrees, transform(to_km, geometry).buffer(radius)))

keep = unary_union(buffered)

# One prepared geometry rather than a contains() call per station against a
# multipolygon with a hundred parts
try:
    from shapely.prepared import prep
    inside = prep(keep).contains
except ImportError:
    inside = keep.contains

from shapely.geometry import Point
before = len(rows)
rows = [row for row in rows if inside(Point(row[0], row[1]))]

snapshot["stations"] = rows
snapshot["count"] = len(rows)
snapshot["bbox"] = [round(v, 4) for v in keep.bounds]

# Recount per source after the trim, so the published file describes itself
# rather than the larger set it was cut from
sources = snapshot.get("sources") or {}
if "source" in (snapshot.get("columns") or []):
    index = snapshot["columns"].index("source")
    if "reference" in sources:
        sources["reference"]["count"] = sum(1 for r in rows if r[index] == 0)
    if "citizen" in sources:
        sources["citizen"]["count"] = sum(1 for r in rows if r[index] == 1)

with open(destination, "w") as handle:
    json.dump(snapshot, handle, separators=(",", ":"))

print(f"  stations published: {len(rows)} of {before}", file=sys.stderr)
TRIM

gzip -9 -c "$PUBLISHED" > "$STAGING/stations.json"

python3 - "$STAGING" "$PUBLISHED" "$MIN_ZOOM" "$MAX_ZOOM" \
  "$GRID_DEGREES" "$INFLUENCE_KM" "$MASK_KM" "$MAX_AGE_HOURS" <<'PY'
import gzip, json, os, sys, time

staging, stations_path = sys.argv[1], sys.argv[2]
min_zoom, max_zoom = int(sys.argv[3]), int(sys.argv[4])
grid, influence, mask, max_age = (float(value) for value in sys.argv[5:9])

with open(stations_path) as handle:
    snapshot = json.load(handle)

# Beside tippecanoe's own metadata.json rather than replacing it. This one is
# for a person reading the directory: the band edges and the two radii are all
# parameters, so a build has to be able to say which ones produced it
with open(os.path.join(staging, "wayside.json"), "w") as handle:
    json.dump(
        {
            "built": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "minzoom": min_zoom,
            "maxzoom": max_zoom,
            "parameter": snapshot.get("parameter"),
            "unit": snapshot.get("unit"),
            "stations": snapshot.get("count"),
            "observed": snapshot.get("fetched"),
            # What this tileset is made of and under what terms. Written here
            # so that the licence question has an answer sitting beside the
            # tiles rather than only in a README that can drift from them
            "sources": snapshot.get("sources"),
            "boundaries": {
                "source": "OpenStreetMap via Nominatim",
                "licence": "ODbL 1.0",
            },
            "model": {
                "kind": "idw-shepard",
                "gridDegrees": grid,
                "influenceKm": influence,
                "maskKm": mask,
                "maxAgeHours": max_age,
            },
            "bands": {
                "1": "good, under 10 µg/m³",
                "2": "fair, 10-20",
                "3": "moderate, 20-25",
                "4": "poor, 25-50",
                "5": "very poor, 50-75",
                "6": "extremely poor, over 75",
            },
            "scale": "EAQI PM2.5 breakpoints (European Environment Agency)",
        },
        handle,
        indent=2,
    )
PY

# `ln -sfn` on an existing symlink to a directory would put the new link inside
# it. -T says the target is the link itself, which is what makes this a replace
# rather than a nest, and what makes it atomic
ln -sfnT "$(basename "$STAGING")" "$TILE_DIR/current.new"
mv -T "$TILE_DIR/current.new" "$TILE_DIR/current"

# Everything but the build the link now points at. An hourly job would
# otherwise fill the volume in a week
find "$TILE_DIR" -maxdepth 1 -name 'build-*' -not -name "$(basename "$STAGING")" \
  -exec rm -rf {} +

log "done: $(find "$STAGING" -name '*.pbf' | wc -l) tiles in $TILE_DIR/current"
