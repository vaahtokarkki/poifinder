# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# Which region the database covers. Any OSM extract works: Geofabrik publishes
# one per country and continent, and download.openstreetmap.fr has smaller
# ones. The whole planet is possible and is a machine of its own.
#   https://download.geofabrik.de/
OVERPASS_PLANET_URL=https://download.geofabrik.de/europe/finland-latest.osm.pbf

# A continent or the world, without ever holding either on the disk. With a
# region list set the extract is downloaded and filtered one region at a time
# and merged at the end, so the peak disk is the largest single region rather
# than the whole thing, and a run that dies resumes instead of downloading it
# all again. OVERPASS_PLANET_URL then only has to be something small: the
# entrypoint insists on downloading it, and the list is what actually gets
# imported.
#
# Two lists are in the image. world-regions.txt covers every city the app has a
# page for (87 regions, ~54 GB of downloads); europe-regions.txt is Europe only
# (49 regions, ~35 GB) and leaves the non-European cities answering empty.
#
# It does not lower the memory the filter needs, which is about 2 GB whatever
# the region. See "What it costs" in README.md
# WAYSIDE_REGION_LIST=/opt/wayside/world-regions.txt
# OVERPASS_PLANET_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
# OVERPASS_PLANET_PREPROCESS=build-region-extract /db/planet.osm.bz2

# Whether to keep the buildings the points stand in. This is what lets the app
# say a toilet is in the Iso Omena centre, at Piispansilta 11, and draw the
# centre behind the marker; the buildings are kept as they are and the app
# works out which one holds which point from the geometry. It costs
# another pass over the extract at import time and a copy of the region's
# buildings on the disk while that runs; set it to false on a machine where
# that is the thing that will not fit
# WAYSIDE_JOIN_BUILDINGS=true

# Host port for the API. The interpreter ends up at
# http://<host>:<port>/api/interpreter, which is what VITE_OVERPASS_API_URL wants
OVERPASS_PORT=12345

# Which host address to publish that port on. 127.0.0.1 when a tunnel or a
# reverse proxy on this same machine is the only thing that should reach it,
# which is also the only way to keep an unauthenticated API off your LAN
OVERPASS_BIND_ADDR=0.0.0.0

# Origins allowed to read the answers. "*" for a public API, or the app's
# origin (https://wayside.cc) to keep it to your own pages. Note that this is a
# browser rule, not access control: anything can still query it with curl
OVERPASS_CORS_ORIGIN=*

# Longest query the server will accept, and how much RAM one may use (bytes).
# The app's queries need neither, the limits are there to bound a bad one
OVERPASS_MAX_TIMEOUT=180s
OVERPASS_SPACE=2147483648

# Concurrent queries allowed from one address
OVERPASS_RATE_LIMIT=8

# How much the importer buffers before it writes. Lower is slower and needs
# less RAM: drop to 4 or 2 on a machine that got OOM killed during an import,
# raise it on one with memory to spare
OVERPASS_FLUSH_SIZE=16

# How long the first import is expected to take, so the health check does not
# call the container unhealthy while it is still importing
OVERPASS_IMPORT_TIME=6h

# Upstream image tag to build on
OVERPASS_VERSION=v0.7.62.11
